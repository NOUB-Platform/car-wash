# Supabase Configuration (Optional - can also be configured inside the app settings UI)
# Get these values from Supabase Dashboard -> Project Settings -> API Keys
# Supports both the new Publishable key (sb_publishable_...) and legacy anon key (eyJ...)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# GEMINI_API_KEY: Kept in template if AI features are ever enabled later
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
